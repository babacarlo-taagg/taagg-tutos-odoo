# Copier ce fichier en « .env » (même dossier) et remplir. Le fichier .env n'est jamais envoyé sur GitHub.

# Odoo à filmer — de préférence une base de DÉMONSTRATION, jamais de vraies données d'élèves
ODOO_URL=https://core.taagg-gui.com
ODOO_BASE=taagg_tuto
ODOO_LOGIN=
ODOO_MOT_DE_PASSE=

# Voix ElevenLabs (recommandée : la plus naturelle en français, clonage de la voix de Babacar possible)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODELE=eleven_multilingual_v2

# Ou voix OpenAI
OPENAI_API_KEY=
# OPENAI_VOIX=coral
